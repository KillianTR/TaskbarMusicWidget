<Window x:Class="TaskbarMusicWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MusicWidget" 
        Height="36" Width="260"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        Topmost="True" 
        ShowInTaskbar="False"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- Estilo para los botones en la barra de tareas -->
        <Style x:Key="TaskbarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="4" Padding="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#25FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#40FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para el contenedor del widget con hover sutil -->
        <Style x:Key="WidgetContainerStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="4,2"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#15FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Window.ContextMenu>
        <ContextMenu Background="#202020" Foreground="#FFFFFF" BorderBrush="#33FFFFFF">
            <MenuItem Header="Reconectar reproductor" Click="MenuReconnect_Click"/>
            <Separator Background="#33FFFFFF"/>
            <MenuItem Header="Cerrar widget" Click="MenuExit_Click"/>
        </ContextMenu>
    </Window.ContextMenu>

    <!-- Contenedor transparente integrado a la barra de tareas con rueda de volumen -->
    <Border x:Name="RootBorder" 
            Style="{StaticResource WidgetContainerStyle}"
            MouseEnter="Widget_MouseEnter" 
            MouseLeave="Widget_MouseLeave"
            PreviewMouseWheel="Widget_PreviewMouseWheel">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Carátula pequeña (Clic para abrir reproductor) -->
            <Border Grid.Column="0" Width="26" Height="26" CornerRadius="4" 
                    ClipToBounds="True" Background="#2A2A2A" VerticalAlignment="Center"
                    Cursor="Hand" MouseLeftButtonUp="TrackInfo_MouseLeftButtonUp" ToolTip="Abrir reproductor">
                <Image x:Name="AlbumArt" Stretch="UniformToFill"/>
            </Border>

            <!-- Título y Artista (Clic para abrir reproductor + Marquee para textos largos) -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,6,0"
                        Cursor="Hand" MouseLeftButtonUp="TrackInfo_MouseLeftButtonUp" ToolTip="Abrir reproductor">
                <Grid x:Name="TitleContainer" ClipToBounds="True" Height="15">
                    <TextBlock x:Name="TxtTitle" Text="Sin música" Foreground="#FFFFFF" 
                               FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                               HorizontalAlignment="Left">
                        <TextBlock.RenderTransform>
                            <TranslateTransform x:Name="TitleTransform" X="0"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </Grid>
                <TextBlock x:Name="TxtArtist" Text="Esperando..." Foreground="#A8A8A8" 
                           FontSize="9.5" TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <!-- Controles vectoriales en blanco (⏮, ▶/⏸, ⏭) -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Anterior: |◀ -->
                <Button x:Name="BtnPrev" Style="{StaticResource TaskbarButton}" 
                        Width="22" Height="24" Click="BtnPrev_Click" ToolTip="Anterior">
                    <Path Width="12" Height="12" Stretch="Uniform" Fill="#FFFFFF" 
                          Data="M 2,2.5 L 4,2.5 L 4,11.5 L 2,11.5 Z M 12,2.5 L 4.5,7 L 12,11.5 Z"/>
                </Button>

                <!-- Play / Pausa (con pausa real de 2 barras, no stop cuadrado) -->
                <Button x:Name="BtnPlayPause" Style="{StaticResource TaskbarButton}" 
                        Width="24" Height="24" Click="BtnPlayPause_Click" ToolTip="Reproducir / Pausar">
                    <Path x:Name="MainPlayPausePath" Width="12" Height="12" Stretch="Uniform" Fill="#FFFFFF" 
                          Data="M 3.5,2 L 12,7 L 3.5,12 Z"/>
                </Button>

                <!-- Siguiente: ▶| -->
                <Button x:Name="BtnNext" Style="{StaticResource TaskbarButton}" 
                        Width="22" Height="24" Click="BtnNext_Click" ToolTip="Siguiente">
                    <Path Width="12" Height="12" Stretch="Uniform" Fill="#FFFFFF" 
                          Data="M 2,2.5 L 9.5,7 L 2,11.5 Z M 10,2.5 L 12,2.5 L 12,11.5 L 10,11.5 Z"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>